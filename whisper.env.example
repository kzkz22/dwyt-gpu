# whisper.env (chmod 600) - settings of the Whisper container
# Hugging Face token (read) for speaker separation; accept the terms of
# pyannote/speaker-diarization-community-1 on its model page first.
HF_TOKEN=
# Whisper models this worker accepts (as in models.yaml, whisper.models)
WHISPER_MODELS=large-v3,large-v3-turbo
# auto | cuda | cpu
DEVICE=auto
# largest audio accepted, MB
MAX_AUDIO_MB=2048
